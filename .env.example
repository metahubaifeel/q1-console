# 复制成 .env 再填。这个文件不要提交。
#
# 直连（机器人插在这台电脑的 USB-C 口上）
#   Q1_HOST=10.1.1.100
#   Q1_LAN_HOST=10.1.1.100
#
# 借道另一台机器（机器人插在别的电脑上，本机走 SSH 隧道）
#   ssh -N -L 127.0.0.1:2222:10.1.1.100:22 \
#          -L 127.0.0.1:2554:10.1.1.100:2554 \
#          -L 127.0.0.1:8799:10.1.1.100:8799  <那台机器>
#   Q1_HOST=127.0.0.1
#   Q1_LAN_HOST=127.0.0.1
#   Q1_SSH_PORT=2222
#   Q1_LAN_MODE=1

Q1_HOST=10.1.1.100
Q1_LAN_HOST=10.1.1.100
Q1_USER=run
Q1_PASS=改成机器人上 run 账号的密码

# 机器人不在本机网段时，SSH 走本地隧道的端口（留空 = 直连 22）
Q1_SSH_PORT=

# 强制当作「同一网段」，跳过 onlink 判断。走隧道时必须设 1。
Q1_LAN_MODE=

# 指定从哪块网卡出去（USB 网卡名形如 enxec1ac35767bd）
Q1_LAN_IFACE=

# RTSP 流名，随机型不同：
#   Q1  live_head_monocular_centra   (1280x720)
#   T1  live_head_stereo_left        (640x480, 左目)
#       live_head_stereo_right
Q1_RTSP_PATH=live_head_monocular_centra

# Tailscale 回退（机器人不在同一个局域网时）
Q1_TS_HOST=
# 机器人 WiFi 名，只用来在界面上显示，可留空
Q1_WIFI=
